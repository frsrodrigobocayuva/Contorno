{
  "openapi": "3.1.0",
  "info": {
    "title": "Contorno",
    "version": "0.1.0"
  },
  "paths": {
    "/rotas/calculo": {
      "post": {
        "summary": "Calcular",
        "description": "A irrestrita e, com áreas, a restrita validada; sem caminho, o diagnóstico (D6).",
        "operationId": "calcular_rotas_calculo_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoDeRota"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/RespostaRotas"
                    },
                    {
                      "$ref": "#/components/schemas/RespostaDiagnostico"
                    }
                  ],
                  "title": "Response Calcular Rotas Calculo Post",
                  "discriminator": {
                    "propertyName": "tipo",
                    "mapping": {
                      "ROTAS": "#/components/schemas/RespostaRotas",
                      "DIAGNOSTICO": "#/components/schemas/RespostaDiagnostico"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/restricoes/area": {
      "post": {
        "summary": "Definir Area",
        "description": "As células da área, o contorno delas e os conflitos com a origem e o destino (UC02).\n\nRecusa, antes do domínio (DAS 6.10), desenho fora de São Leopoldo e Novo Hamburgo, com menos\nde três vértices distintos ou que se cruza.",
        "operationId": "definir_area_restricoes_area_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PedidoDeArea"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaArea"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          }
        }
      }
    },
    "/enderecos": {
      "get": {
        "summary": "Buscar",
        "description": "Até 5 lugares no recorte; sem resultado ou com o serviço fora do ar, lista vazia e motivo.",
        "operationId": "buscar_enderecos_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespostaEnderecos"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "description": "Responde 200 só quando o motor de rotas também responde.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CausaDeInviabilidade": {
        "type": "string",
        "enum": [
          "DESTINO_INALCANCAVEL",
          "RESTRICAO_UNICA",
          "COMBINACAO_DE_RESTRICOES",
          "AREAS_BLOQUEIAM"
        ],
        "title": "CausaDeInviabilidade"
      },
      "Erro": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          },
          "detalhes": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalhes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "codigo",
          "mensagem"
        ],
        "title": "Erro",
        "description": "Formato único de erro (DAS 6.9)."
      },
      "Extremo": {
        "type": "string",
        "enum": [
          "ORIGEM",
          "DESTINO"
        ],
        "title": "Extremo"
      },
      "LinhaGeoJSON": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "prefixItems": [
                {
                  "type": "number",
                  "maximum": 180.0,
                  "minimum": -180.0
                },
                {
                  "type": "number",
                  "maximum": 90.0,
                  "minimum": -90.0
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "LinhaGeoJSON"
      },
      "LugarDTO": {
        "properties": {
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "coordenada": {
            "prefixItems": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Coordenada"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nome",
          "coordenada"
        ],
        "title": "LugarDTO"
      },
      "MotivoDeBuscaVazia": {
        "type": "string",
        "enum": [
          "SEM_RESULTADO",
          "SERVICO_INDISPONIVEL"
        ],
        "title": "MotivoDeBuscaVazia"
      },
      "MultiPoligonoGeoJSON": {
        "properties": {
          "type": {
            "type": "string",
            "const": "MultiPolygon",
            "title": "Type",
            "default": "MultiPolygon"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "prefixItems": [
                    {
                      "type": "number",
                      "maximum": 180.0,
                      "minimum": -180.0
                    },
                    {
                      "type": "number",
                      "maximum": 90.0,
                      "minimum": -90.0
                    }
                  ],
                  "type": "array",
                  "maxItems": 2,
                  "minItems": 2
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "MultiPoligonoGeoJSON"
      },
      "PedidoDeArea": {
        "properties": {
          "poligono": {
            "items": {
              "prefixItems": [
                {
                  "type": "number",
                  "maximum": 180.0,
                  "minimum": -180.0
                },
                {
                  "type": "number",
                  "maximum": 90.0,
                  "minimum": -90.0
                }
              ],
              "type": "array",
              "maxItems": 2,
              "minItems": 2
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 3,
            "title": "Poligono",
            "description": "Vértices do desenho, em ordem, sem repetir o primeiro no fim."
          },
          "origem": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number",
                    "maximum": 180.0,
                    "minimum": -180.0
                  },
                  {
                    "type": "number",
                    "maximum": 90.0,
                    "minimum": -90.0
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Origem"
          },
          "destino": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number",
                    "maximum": 180.0,
                    "minimum": -180.0
                  },
                  {
                    "type": "number",
                    "maximum": 90.0,
                    "minimum": -90.0
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Destino"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "poligono"
        ],
        "title": "PedidoDeArea",
        "description": "Desenho do usuário (UC02) e, se já escolhidos, a origem e o destino da consulta."
      },
      "PedidoDeRota": {
        "properties": {
          "origem": {
            "prefixItems": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Origem"
          },
          "destino": {
            "prefixItems": [
              {
                "type": "number",
                "maximum": 180.0,
                "minimum": -180.0
              },
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              }
            ],
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Destino"
          },
          "restricoes": {
            "items": {
              "$ref": "#/components/schemas/RestricaoArea"
            },
            "type": "array",
            "title": "Restricoes",
            "description": "Áreas declaradas; as preferências de via entram na S5-02."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origem",
          "destino"
        ],
        "title": "PedidoDeRota"
      },
      "RespostaArea": {
        "properties": {
          "celulas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Celulas",
            "description": "Células H3 compactadas, em hexadecimal (ADR-011)."
          },
          "contorno": {
            "$ref": "#/components/schemas/MultiPoligonoGeoJSON"
          },
          "areaDesenhadaM2": {
            "type": "number",
            "title": "Areadesenhadam2"
          },
          "areaProibidaM2": {
            "type": "number",
            "title": "Areaproibidam2"
          },
          "conflitos": {
            "items": {
              "$ref": "#/components/schemas/Extremo"
            },
            "type": "array",
            "title": "Conflitos",
            "description": "Extremos que caem dentro da área (UC02, B)."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "celulas",
          "contorno",
          "areaDesenhadaM2",
          "areaProibidaM2",
          "conflitos"
        ],
        "title": "RespostaArea",
        "description": "A área proibida para o usuário conferir (UC02; RN04)."
      },
      "RespostaDiagnostico": {
        "properties": {
          "tipo": {
            "type": "string",
            "const": "DIAGNOSTICO",
            "title": "Tipo",
            "default": "DIAGNOSTICO"
          },
          "causa": {
            "$ref": "#/components/schemas/CausaDeInviabilidade"
          },
          "candidatas": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Candidatas"
          },
          "mensagem": {
            "type": "string",
            "title": "Mensagem"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "causa",
          "candidatas",
          "mensagem"
        ],
        "title": "RespostaDiagnostico",
        "description": "Inviabilidade: 200 com um objeto só de diagnóstico (plano, D6)."
      },
      "RespostaEnderecos": {
        "properties": {
          "lugares": {
            "items": {
              "$ref": "#/components/schemas/LugarDTO"
            },
            "type": "array",
            "title": "Lugares"
          },
          "motivo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MotivoDeBuscaVazia"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lugares"
        ],
        "title": "RespostaEnderecos"
      },
      "RespostaRotas": {
        "properties": {
          "tipo": {
            "type": "string",
            "const": "ROTAS",
            "title": "Tipo",
            "default": "ROTAS"
          },
          "irrestrita": {
            "$ref": "#/components/schemas/RotaDTO"
          },
          "restrita": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RotaDTO"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "irrestrita"
        ],
        "title": "RespostaRotas"
      },
      "RestricaoArea": {
        "properties": {
          "tipo": {
            "type": "string",
            "const": "AREA",
            "title": "Tipo"
          },
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id",
            "description": "Gerado no cliente (plano, A8)."
          },
          "rotulo": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Rotulo",
            "description": "O nome, ou \"Área N\"."
          },
          "celulas": {
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{15,16}$"
            },
            "type": "array",
            "maxItems": 20000,
            "minItems": 1,
            "title": "Celulas"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tipo",
          "id",
          "rotulo",
          "celulas"
        ],
        "title": "RestricaoArea",
        "description": "Área declarada, com as células que o cliente recebeu em /restricoes/area (UC01, [2])."
      },
      "RotaDTO": {
        "properties": {
          "geometria": {
            "$ref": "#/components/schemas/LinhaGeoJSON"
          },
          "duracaoSegundos": {
            "type": "number",
            "title": "Duracaosegundos"
          },
          "distanciaMetros": {
            "type": "number",
            "title": "Distanciametros"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "geometria",
          "duracaoSegundos",
          "distanciaMetros"
        ],
        "title": "RotaDTO"
      }
    }
  }
}
