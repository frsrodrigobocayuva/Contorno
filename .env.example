# Copie para .env e preencha. O .env nunca vai para o repositório.
# Configuração lida uma vez na subida (DAS 6.11). Os valores vêm das medições da S4-04
# e da medição [4], na S5-05 (plano do MVP, A6).

# Motor de rotas, na rede interna do compose
GRAPHHOPPER_URL=http://graphhopper:8989

# Geocodificação (Nominatim público; política de uso no ADR-013)
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Contorno/0.1 (contato: preencher)

# Indexação espacial (ADR-010; confirmada pela medição [1] da S4-04)
H3_RESOLUTION=11

# Retângulo do recorte São Leopoldo + Novo Hamburgo: min_lon,min_lat,max_lon,max_lat
# Limites oficiais no OSM: Sao Leopoldo (relation/242399) e Novo Hamburgo (relation/242616).
AREA_BBOX=-51.2100287,-29.8302389,-50.9341246,-29.6377057

# Raio de exclusão a partir de endereço, em metros (plano, D11)
RADIUS_MIN_M=100
RADIUS_MAX_M=2000

# Tempo máximo de uma chamada ao motor, em segundos. Era 2 (medições [1] e [5] da S4-04);
# subiu para 5 na S5-03, porque áreas de alguns km² levam uma chamada a mais de 1 s
ENGINE_TIMEOUT_S=5

# Tempo máximo de uma chamada ao Nominatim, em segundos: mais de 4x o pior tempo da
# medição [4] (1,15 s; p95 1,13 s), a mesma folga do motor
GEOCODER_TIMEOUT_S=5

# Chamadas simultâneas do diagnóstico ao motor: o menor p95 medido com 3 e com 10 áreas
# (medição [5] da S4-04)
DIAGNOSIS_CONCURRENCY=4

# Cache em memória do Nominatim: na medição [4], até 4 buscas por sessão, e as repetidas,
# minutos depois, vieram todas do cache
GEOCODER_CACHE_SIZE=256
GEOCODER_CACHE_TTL_S=3600

# Só em produção (compose.prod.yaml, ADR-015): o endereço público, que o Caddy usa
# para emitir o certificado do HTTPS
# DOMINIO=contorno.duckdns.org
